@model Procedimento
<h1>Novo procedimento</h1><form asp-action="Create" method="post" class="form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="alert"></div><label>Nome<input asp-for="Nome"></label><label>Descrição<textarea asp-for="Descricao"></textarea></label><label>Duração (minutos)<input asp-for="DuracaoMinutos" type="number"></label><label>Valor<input asp-for="Valor" type="number" step="0.01"></label><label>Status<select asp-for="Status"><option>ativo</option><option>inativo</option></select></label><button class="primary">Salvar</button> <a asp-action="Index">Cancelar</a></form>
