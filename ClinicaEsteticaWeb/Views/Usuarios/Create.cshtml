@model Usuario
<h1>Novo usuário</h1><form asp-action="Create" method="post" class="form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="alert"></div><label>Nome<input asp-for="Nome"></label><label>Login<input asp-for="Login"></label><label>Senha<input asp-for="Senha" type="password"></label><label>Perfil<select asp-for="Perfil"><option>recepcionista</option><option>administrador</option></select></label><label>Status<select asp-for="Status"><option>ativo</option><option>inativo</option></select></label><button class="primary">Salvar</button> <a asp-action="Index">Cancelar</a></form>
