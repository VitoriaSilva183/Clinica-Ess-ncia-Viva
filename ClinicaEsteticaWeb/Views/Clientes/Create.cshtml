@model Cliente
<h1>Novo cliente</h1><form asp-action="Create" method="post" class="form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="alert"></div><label>Nome<input asp-for="Nome"></label><label>CPF<input asp-for="CPF" placeholder="somente números ou formatado"></label><label>Data de nascimento<input asp-for="DataNascimento" type="date"></label><label>Telefone<input asp-for="Telefone"></label><label>E-mail<input asp-for="Email" type="email"></label><label>Endereço<input asp-for="Endereco"></label><label>Observações<textarea asp-for="Observacoes"></textarea></label><label>Status<select asp-for="Status"><option>ativo</option><option>inativo</option></select></label><button class="primary">Salvar</button> <a asp-action="Index">Cancelar</a></form>
