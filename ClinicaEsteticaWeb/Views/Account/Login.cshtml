@model LoginViewModel
<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Login - Essência Viva</title><link rel="stylesheet" href="~/css/site.css"></head><body class="login-page"><div class="login-card">
<h1>Essência Viva</h1><p>Clínica estética</p>@if(ViewBag.Error!=null){<div class="alert">@ViewBag.Error</div>}<form asp-action="Login" method="post">@Html.AntiForgeryToken()<label>Usuário<input asp-for="Login" autocomplete="username"></label><label>Senha<input asp-for="Senha" type="password" autocomplete="current-password"></label><button class="primary">Entrar</button></form><small>Ambiente de demonstração: sessão configurada para 1 minuto.</small></div></body></html>
