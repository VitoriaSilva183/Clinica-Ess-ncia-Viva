@model AgendamentoForm
<h1>Novo agendamento</h1><form asp-action="Create" method="post" class="form">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="alert"></div><label>Cliente<select asp-for="ClienteId"><option value="">Selecione</option>@foreach(var x in (List<(int,string)>)ViewBag.Clientes){<option value="@x.Item1">@x.Item2</option>}</select></label><label>Profissional<select asp-for="ProfissionalId"><option value="">Selecione</option>@foreach(var x in (List<(int,string)>)ViewBag.Profissionais){<option value="@x.Item1">@x.Item2</option>}</select></label><label>Data<input asp-for="Data" type="date"></label><label>Hora início<input asp-for="HoraInicio" type="time"></label><label>Hora fim<input asp-for="HoraFim" type="time"></label><label>Procedimentos</label><div class="checks">@foreach(var p in (List<(int,string,decimal)>)ViewBag.Procedimentos){<label><input type="checkbox" name="ProcedimentosIds" value="@p.Item1"> @p.Item2 (@p.Item3.ToString("C"))</label>}</div><button class="primary">Agendar</button> <a asp-action="Index">Cancelar</a></form>
