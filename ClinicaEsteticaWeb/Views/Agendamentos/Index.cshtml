@model IEnumerable<Agendamento>
<h1>Agenda</h1><a class="primary linkbtn" asp-action="Create">Novo agendamento</a><table><thead><tr><th>Data</th><th>Horário</th><th>Cliente</th><th>Profissional</th><th>Situação</th><th>Total</th><th></th></tr></thead><tbody>@foreach(var a in Model){<tr><td>@a.Data.ToString("dd/MM/yyyy")</td><td>@a.HoraInicio - @a.HoraFim</td><td>@a.ClienteNome</td><td>@a.ProfissionalNome</td><td>@a.Situacao</td><td>@a.ValorTotal.ToString("C")</td><td>@if(a.Situacao!="cancelado"){<form asp-action="Cancel" method="post" class="inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.Id"><button>Cancelar</button></form>}</td></tr>}</tbody></table>
